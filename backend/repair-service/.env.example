NODE_ENV=development
PORT=3004

DB_HOST=YOUR_RAILWAY_HOST
DB_PORT=YOUR_RAILWAY_PORT
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=repair_db

DB_POOL_MIN=0
DB_POOL_MAX=5

# Payment Service URL for server-side handover balance verification
PAYMENT_SERVICE_URL=http://localhost:3006

# JWT verification (same values as API Gateway / User Service)
JWT_ISSUER=com-tle-user-service
JWT_AUDIENCE=com-tle-api
JWT_PUBLIC_KEY_PATH=keys/public.pem