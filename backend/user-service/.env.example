NODE_ENV=development
PORT=3001

DB_HOST=YOUR_RAILWAY_HOST
DB_PORT=YOUR_RAILWAY_PORT
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=user_db

DB_POOL_MIN=0
DB_POOL_MAX=5

JWT_ISSUER=com-tle-user-service
JWT_AUDIENCE=com-tle-api
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000
JWT_PRIVATE_KEY_PATH=./keys/private.pem

# Optional internal service permission-check bridge. Configure only for
# trusted service-to-service traffic; the public API Gateway must not proxy it.
INTERNAL_SERVICE_JWT_PUBLIC_KEYS_DIR=
INTERNAL_SERVICE_JWT_ISSUER=
INTERNAL_SERVICE_JWT_AUDIENCE=
INTERNAL_SERVICE_JWT_ALLOWED_SERVICES=
# Comma-separated kid:service-id pairs; every trusted key needs one mapping.
INTERNAL_SERVICE_JWT_KEY_SERVICES=
INTERNAL_SERVICE_JWT_MAX_LIFETIME_SECONDS=300