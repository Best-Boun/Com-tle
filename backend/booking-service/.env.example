NODE_ENV=development
PORT=3002

DB_HOST=YOUR_RAILWAY_HOST
DB_PORT=YOUR_RAILWAY_PORT
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=booking_db

DB_POOL_MIN=0
DB_POOL_MAX=5

# JWT verification (same values as API Gateway / User Service)
JWT_ISSUER=com-tle-user-service
JWT_AUDIENCE=com-tle-api
JWT_PUBLIC_KEY_PATH=keys/public.pem

# Other services this service calls
CATALOG_SERVICE_URL=http://localhost:3003
REPAIR_SERVICE_URL=http://localhost:3004
SERVICE_CALL_TIMEOUT_MS=5000

# Booking rules
BOOKING_TIMEZONE=Asia/Bangkok
BOOKING_SLOT_TIMES=09:00,10:00,11:00,13:00,14:00,15:00,16:00
BOOKING_SLOT_CAPACITY=2
BOOKING_MAX_DAYS_AHEAD=30
