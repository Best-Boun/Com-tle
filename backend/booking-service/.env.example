NODE_ENV=development
PORT=3002

DB_HOST=YOUR_RAILWAY_HOST
DB_PORT=YOUR_RAILWAY_PORT
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=booking_db

DB_POOL_MIN=0
DB_POOL_MAX=5

# JWT verification (same values as API Gateway / User Service)
JWT_ISSUER=com-tle-user-service
JWT_AUDIENCE=com-tle-api
JWT_PUBLIC_KEY_PATH=keys/public.pem

# Other services this service calls
CATALOG_SERVICE_URL=http://localhost:3003
REPAIR_SERVICE_URL=http://localhost:3004
SERVICE_CALL_TIMEOUT_MS=5000

# Repair request rules
BOOKING_TIMEZONE=Asia/Bangkok
# Catalog service a request is for when the customer picks none (seed HW-DIAG)
REQUEST_DIAGNOSIS_SERVICE_ID=6f1c2a10-0000-4000-8000-000000000003
REQUEST_MAX_OPEN_PER_CUSTOMER=5
REQUEST_EXPIRY_DAYS=30
REQUEST_EXPIRY_CHECK_MINUTES=60
