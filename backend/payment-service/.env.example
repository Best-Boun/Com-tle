NODE_ENV=development
PORT=3006

PAYMENT_USER_SERVICE_BASE_URL=http://localhost:3001
PAYMENT_USER_JWT_ISSUER=com-tle-user-service
PAYMENT_USER_JWT_AUDIENCE=com-tle-api
PAYMENT_USER_JWT_PUBLIC_KEY_PATH=./keys/user-public.pem
# Optional: current User-Service access tokens do not include a kid.
PAYMENT_USER_JWT_KID=

PAYMENT_INTERNAL_JWT_PRIVATE_KEY_PATH=./keys/private.pem
PAYMENT_INTERNAL_JWT_KID=payment-key-1
PAYMENT_INTERNAL_JWT_ISSUER=payment-service
PAYMENT_INTERNAL_JWT_AUDIENCE=user-service
PAYMENT_INTERNAL_SERVICE_ID=payment-service
# Optional; defaults to 60 seconds and is limited to 1-300 seconds.
PAYMENT_INTERNAL_JWT_LIFETIME_SECONDS=60

DB_HOST=YOUR_RAILWAY_HOST
DB_PORT=YOUR_RAILWAY_PORT
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=payment_db

DB_POOL_MIN=0
DB_POOL_MAX=5